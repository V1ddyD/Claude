# Request-path database role: NOT the table owner, NOT BYPASSRLS.
# Tenant isolation depends on this role being unprivileged.
DATABASE_URL=postgres://app_user@localhost:5432/sinclair

# Migrations and tenant provisioning only. Never used to serve a request.
DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/sinclair

# Staff authentication (Supabase). Absent in dev -> the dev auth adapter is used,
# which refuses to load when NODE_ENV=production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The assistant's key. Set ONCE here, by whoever operates the platform.
#
# Customers never supply, see, or are asked for a key — they open the chat and
# type. This value is read by exactly one module (src/server/ai/client.ts),
# never given a NEXT_PUBLIC_ prefix, and never reaches the browser. A lint rule,
# a test and a CI grep of the built bundle each enforce that independently.
#
# Absent, the assistant degrades to a contact form and says so honestly. It
# never asks the customer to configure anything.
ANTHROPIC_API_KEY=

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Signs the anonymous visitor cookie. 32+ random bytes, base64.
SESSION_SECRET=

CRON_SECRET=

# Local development only: which tenant an unrecognised hostname resolves to.
DEFAULT_TENANT_SLUG=sinclair
